{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Odoo Sandbox: module test",
      "type": "shell",
      "command": "${workspaceFolder}/sandbox/bin/sandbox-agent",
      "args": ["test", "${input:sandboxName}", "${input:sessionId}", "${input:moduleName}"],
      "problemMatcher": []
    },
    {
      "label": "Odoo Sandbox: correlated Odoo logs",
      "type": "shell",
      "command": "${workspaceFolder}/sandbox/bin/sandbox-agent",
      "args": ["logs", "${input:sandboxName}", "${input:sessionId}", "odoo"],
      "problemMatcher": []
    }
  ],
  "inputs": [
    {"id": "sandboxName", "type": "promptString", "description": "Docker Sandbox name"},
    {"id": "sessionId", "type": "promptString", "description": "Odoo session ID"},
    {"id": "moduleName", "type": "promptString", "description": "Odoo module", "default": "sandbox_fixture"}
  ]
}
