#!/usr/bin/env python3
"""Bounded, single-host Community coordinator for Docker Sandbox sessions."""

import argparse
import datetime as dt
import fcntl
import json
import os
import re
import shlex
import signal
import subprocess
import sys
import tarfile
import tempfile
import time
from contextlib import contextmanager
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
STATE = ROOT / ".sandbox/fleet"
SESSIONS = STATE / "sessions"
LOCK = STATE / "controller.lock"
POLICY = ROOT / "sandbox/config/concurrency.json"
AGENT = ROOT / "sandbox/bin/sandbox-agent"
KIT = "sandbox/kits/odoo-mixin"
BUNDLES = STATE / "bundles"
# sbx --cloud billable shapes (vCPU, GiB) and the agents that have a cloud template.
CLOUD_SHAPES = {(1, 2): "micro", (2, 4): "small", (4, 8): "medium", (8, 16): "large", (16, 32): "xl"}
CLOUD_AGENTS = {"codex", "claude"}


def now():
    return dt.datetime.now(dt.timezone.utc).isoformat().replace("+00:00", "Z")


def parse_time(value):
    return dt.datetime.fromisoformat(value.replace("Z", "+00:00"))


def policy():
    return json.loads(POLICY.read_text())


@contextmanager
def controller_lock():
    STATE.mkdir(parents=True, exist_ok=True)
    with LOCK.open("a+") as stream:
        fcntl.flock(stream, fcntl.LOCK_EX)
        yield


def normalize(value):
    value = re.sub(r"[^a-z0-9]+", "-", value.lower()).strip("-")
    return value[:40] or "module"


def session_name(version, module, token=None):
    token = token or os.urandom(3).hex()
    return f"odoo-{version.removesuffix('.0')}-{normalize(module)}-{token}"


def branch_name(name):
    return f"sandbox/{name}"


def session_path(name):
    return SESSIONS / f"{name}.json"


def read_sessions():
    if not SESSIONS.exists():
        return []
    values = []
    for path in sorted(SESSIONS.glob("*.json")):
        try:
            values.append(json.loads(path.read_text()))
        except (OSError, json.JSONDecodeError):
            continue
    return values


def write_session(data):
    SESSIONS.mkdir(parents=True, exist_ok=True)
    data["updated_at"] = now()
    target = session_path(data["session_id"])
    temporary = target.with_suffix(".tmp")
    temporary.write_text(json.dumps(data, indent=2) + "\n")
    temporary.replace(target)


def run(command, *, check=True, capture=False, cwd=None):
    return subprocess.run(command, check=check, text=True, capture_output=capture, cwd=cwd)


def active_count(sessions):
    # Failed sessions retain their microVM for diagnosis and still consume
    # capacity until stopped, cancelled, or destroyed. Failed provisioning that
    # already removed its outer Sandbox does not consume a runtime slot.
    return sum(
        item["status"] in {"provisioning", "ready", "active", "failed", "destroying"}
        and not (item["status"] == "failed" and item.get("cleanup", {}).get("outer_removed"))
        for item in sessions
    )


def require_capacity(sessions):
    maximum = policy()["max_active_sessions"]
    if active_count(sessions) >= maximum:
        raise RuntimeError(f"Community concurrency limit reached ({maximum})")


def sbx(*args, cloud=False):
    """The sbx client, overridable with SANDBOX_SBX (e.g. the linux/amd64 container on Intel macOS)."""
    return [*shlex.split(os.environ.get("SANDBOX_SBX", "sbx")), *(["--cloud"] if cloud else []), *args]


def cloud_shape(cpus, memory_gib):
    shape = CLOUD_SHAPES.get((int(cpus), int(memory_gib)))
    if not shape:
        raise RuntimeError(f"cloud sandboxes need a billable shape, not {cpus} vCPU / {memory_gib} GiB: {sorted(CLOUD_SHAPES.values())}")
    return shape


def git(repo, *args, env=None):
    return subprocess.run(["git", "-C", str(repo), *args], check=True, text=True, capture_output=True, env=env).stdout.strip()


def worktree_snapshot(repo):
    """Commit the working tree (tracked and untracked, not ignored) on top of HEAD.

    A throwaway index keeps the user's index, branch, and refs untouched; the commit object is
    only reachable through the bundle written next.
    """
    with tempfile.TemporaryDirectory() as tmp:
        env = {**os.environ, "GIT_INDEX_FILE": str(Path(tmp) / "index")}
        git(repo, "read-tree", "HEAD", env=env)
        git(repo, "add", "-A", env=env)
        tree = git(repo, "write-tree", env=env)
    return git(repo, "-c", "user.name=sandbox-fleet", "-c", "user.email=sandbox-fleet@localhost",
               "commit-tree", tree, "-p", "HEAD", "-m", "sandbox-fleet worktree snapshot")


def write_bundle(repo, commit, path):
    ref = f"refs/sandbox-fleet/{commit[:12]}"
    Path(path).parent.mkdir(parents=True, exist_ok=True)
    git(repo, "update-ref", ref, commit)
    try:
        git(repo, "bundle", "create", str(path), ref)
    finally:
        git(repo, "update-ref", "-d", ref)


IMPORT_EXCLUDES = {".git", ".env", "__pycache__"}


def import_payload(name, source, requirements):
    """Pack an import staging tree and its requirements files for one cloud session.

    The archive stays in the gitignored fleet state: imported modules may be private code.
    Git metadata, .env, *.conf and *.log files are left out, as `migrate-local.py` does.
    """
    tree = Path(source).resolve()
    if not tree.is_dir():
        raise RuntimeError(f"import source is not a directory: {tree}")

    def keep(info):
        parts = Path(info.name).parts
        if any(part in IMPORT_EXCLUDES for part in parts) or info.name.endswith((".conf", ".log")):
            return None
        return info

    payload = STATE / "imports" / f"{name}.tgz"
    payload.parent.mkdir(parents=True, exist_ok=True)
    with tarfile.open(payload, "w:gz") as archive:
        archive.add(tree, arcname="tree", filter=keep)
        for index, requirement in enumerate(requirements):
            archive.add(Path(requirement).resolve(), arcname=f"requirements/{index}.txt")
    return payload


def cloud_exec(name, script, label, timeout):
    """Run a script detached inside a cloud sandbox and poll for its exit code.

    `sbx --cloud exec` streams drop on long commands and kill plain background jobs, so the
    script runs under setsid nohup and writes its exit code to a file (cloud runbook).
    """
    BUNDLES.mkdir(parents=True, exist_ok=True)
    local = BUNDLES / f"{name}-{label}.sh"
    remote = f"/tmp/fleet-{label}"
    local.write_text(f"{{\n{script}\n}} > {remote}.log 2>&1\necho $? > {remote}.rc\n")
    run(sbx("cp", str(local.relative_to(ROOT)), f"{name}:{remote}.sh", cloud=True), cwd=ROOT)
    run(sbx("exec", name, "bash", "-c", f"rm -f {remote}.rc; setsid nohup bash {remote}.sh </dev/null >/dev/null 2>&1 &", cloud=True), check=False, capture=True)
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        probe = run(sbx("exec", name, "bash", "-c", f"cat {remote}.rc 2>/dev/null", cloud=True), check=False, capture=True)
        if probe.returncode == 0 and probe.stdout.strip().isdigit():
            tail = run(sbx("exec", name, "bash", "-c", f"tail -40 {remote}.log", cloud=True), check=False, capture=True)
            return int(probe.stdout.strip()), tail.stdout
        time.sleep(10)
    return 124, f"timed out after {timeout}s waiting for {remote}.rc"


def inner_controller(data, *arguments, timeout=1800):
    """Run sandboxctl inside the session's sandbox; returns the exit code."""
    name = data["session_id"]
    if data.get("runtime", {}).get("mode") == "cloud":
        rc, output = cloud_exec(name, "cd ~/kit && sandbox/bin/sandboxctl " + shlex.join(arguments), arguments[0], timeout)
        print(output, end="")
        return rc
    return run(["sbx", "exec", name, "--", "sandbox/bin/sandboxctl", *arguments], check=False).returncode


def parse_port(output):
    matches = re.findall(r"127\.0\.0\.1:(\d+)", output)
    return int(matches[-1]) if matches else None


def cmd_create(args):
    if args.version.removesuffix(".0") not in {"17", "18", "19", "20"}:
        raise RuntimeError("version must be 17, 18, 19, or 20")
    if not re.fullmatch(r"[a-z][a-z0-9_]*", args.module):
        raise RuntimeError("module must be a valid Odoo technical name")
    if args.cloud:
        return create_cloud(args)
    if args.import_source or args.requirements:
        raise RuntimeError("--import and --requirements need --cloud (local fleet sessions use fixtures)")
    outer_creation_attempted = False
    data = None
    try:
        with controller_lock():
            sessions = read_sessions()
            require_capacity(sessions)
            name = session_name(args.version, args.module)
            config = policy()
            data = {
                "schema_version": "1.0.0", "session_id": name, "module": args.module,
                "odoo_version": f"{args.version.removesuffix('.0')}.0", "agent": args.agent,
                "status": "provisioning", "branch": branch_name(name), "created_at": now(),
                "last_activity_at": now(), "ports": [],
                "resources": {"cpus": config["cpus_per_session"], "memory_gib": config["memory_gib_per_session"], "disk_gib": config["disk_gib_per_session"]},
                "result": None, "cleanup_guard": {"commit": False, "push": False, "patch_export": False},
            }
            write_session(data)
        outer_creation_attempted = True
        run([str(AGENT), "create", args.agent, name, str(ROOT), str(config["cpus_per_session"]), f"{config['memory_gib_per_session']}g"])
        run(["sbx", "exec", name, "--", "git", "switch", "-c", data["branch"]])
        container_cpu = str(min(1.0, float(config["cpus_per_session"])))
        run(["sbx", "exec", name, "--", "env", f"ODOO_CPU_LIMIT={container_cpu}", f"POSTGRES_CPU_LIMIT={container_cpu}", "sandbox/bin/sandboxctl", "create", "--version", args.version, "--module", args.module, "--session", name])
        port_result = run(["sbx", "ports", name, "--publish", "8069"], check=False, capture=True)
        host_port = parse_port(port_result.stdout + port_result.stderr)
        if port_result.returncode != 0 or not host_port:
            detail = (port_result.stderr or port_result.stdout or "no published port returned").strip()
            raise RuntimeError(f"required Odoo port publication failed: {detail}")
        data["ports"] = [{"service": "odoo", "container_port": 8069, "host_port": host_port, "host_ip": "127.0.0.1"}]
        data.update(status="ready", last_activity_at=now(), result={"status": "succeeded", "operation": "create"})
        write_session(data)
        print(name)
    except (subprocess.CalledProcessError, RuntimeError, KeyboardInterrupt) as error:
        if data is None:
            raise
        cleanup_errors = []
        previous_sigint = signal.signal(signal.SIGINT, signal.SIG_IGN)
        try:
            if outer_creation_attempted:
                inner = run(
                    ["sbx", "exec", name, "--", "sandbox/bin/sandboxctl", "destroy", name, "--allow-unexported"],
                    check=False, capture=True,
                )
                if inner.returncode:
                    cleanup_errors.append("inner runtime cleanup failed")
                outer = run(["sbx", "rm", "--force", name], check=False, capture=True)
                if outer.returncode:
                    cleanup_errors.append("outer Sandbox cleanup failed")
            result_data = {"status": "failed", "operation": "create", "message": str(error)}
            if cleanup_errors:
                result_data["cleanup_errors"] = cleanup_errors
            data.update(status="failed", result=result_data, cleanup={
                "outer_creation_attempted": outer_creation_attempted,
                "outer_removed": not outer_creation_attempted or "outer Sandbox cleanup failed" not in cleanup_errors,
            })
            write_session(data)
        finally:
            signal.signal(signal.SIGINT, previous_sigint)
        raise


def create_cloud(args):
    """Allocate one fleet session in a Docker Cloud Sandbox. Internal-only: no port is published."""
    if args.agent not in CLOUD_AGENTS:
        raise RuntimeError(f"agent {args.agent} has no cloud template; use one of {sorted(CLOUD_AGENTS)} with --cloud")
    config = policy()
    cloud = config["cloud"]
    shape = cloud_shape(cloud["cpus"], cloud["memory_gib"])
    data = None
    outer_creation_attempted = False
    try:
        with controller_lock():
            sessions = read_sessions()
            require_capacity(sessions)
            name = session_name(args.version, args.module)
            data = {
                "schema_version": "1.0.0", "session_id": name, "module": args.module,
                "odoo_version": f"{args.version.removesuffix('.0')}.0", "agent": args.agent,
                "status": "provisioning", "branch": branch_name(name), "created_at": now(),
                "last_activity_at": now(), "ports": [],
                "resources": {"cpus": cloud["cpus"], "memory_gib": cloud["memory_gib"], "disk_gib": None},
                "runtime": {"mode": "cloud", "shape": shape, "exposure": cloud["exposure"], "snapshot": None, "ttl_minutes": cloud["ttl_minutes"]},
                "result": None, "cleanup_guard": {"commit": False, "push": False, "patch_export": False},
            }
            write_session(data)
        commit = worktree_snapshot(ROOT)
        data["runtime"]["snapshot"] = commit
        bundle = BUNDLES / f"{name}.bundle"
        write_bundle(ROOT, commit, bundle)
        outer_creation_attempted = True
        run(sbx("create", "--name", name, "--cpus", str(cloud["cpus"]), "--memory", f"{cloud['memory_gib']}g",
                "--platform", cloud["platform"], "--ttl", f"{cloud['ttl_minutes']}m", "--kit", KIT, args.agent, cloud=True), cwd=ROOT)
        run(sbx("cp", str(bundle.relative_to(ROOT)), f"{name}:/tmp/kit.bundle", cloud=True), cwd=ROOT)
        unpack, import_flags = "", []
        if args.import_source:
            payload = import_payload(name, args.import_source, args.requirements or [])
            run(sbx("cp", str(payload.relative_to(ROOT)), f"{name}:/tmp/import.tgz", cloud=True), cwd=ROOT)
            unpack = "mkdir -p ~/import && tar -xzf /tmp/import.tgz -C ~/import\n"
            import_flags = ["--import", "~/import/tree"]
            for index in range(len(args.requirements or [])):
                import_flags += ["--requirements", f"~/import/requirements/{index}.txt"]
        elif args.requirements:
            raise RuntimeError("--requirements needs --import in a cloud fleet session")
        container_cpu = str(min(1.0, float(cloud["cpus"]) / 2))
        script = (
            f"set -e\n{unpack}git init -q ~/kit\ncd ~/kit\ngit fetch -q /tmp/kit.bundle 'refs/sandbox-fleet/*:refs/sandbox-fleet/*'\n"
            f"git checkout -q -b {data['branch']} {commit}\n"
            f"SANDBOX_EXEC_MODE=run ODOO_CPU_LIMIT={container_cpu} POSTGRES_CPU_LIMIT={container_cpu} "
            f"sandbox/bin/sandboxctl create --version {args.version} --module {args.module} --session {name}"
            + "".join(f" {flag}" for flag in import_flags)
        )
        rc, output = cloud_exec(name, script, "create", 1800)
        if rc:
            raise RuntimeError(f"inner create failed in cloud sandbox {name} (exit {rc}): {output.strip()[-400:]}")
        # Internal-only by owner decision: `sbx --cloud ports` would give a public URL, so none is published.
        data.update(status="ready", last_activity_at=now(), result={"status": "succeeded", "operation": "create"})
        write_session(data)
        print(name)
    except (subprocess.CalledProcessError, RuntimeError, KeyboardInterrupt) as error:
        if data is None:
            raise
        previous_sigint = signal.signal(signal.SIGINT, signal.SIG_IGN)
        try:
            cleanup_errors = []
            if outer_creation_attempted and run(sbx("rm", "--force", name, cloud=True), check=False, capture=True).returncode:
                cleanup_errors.append("outer Sandbox cleanup failed")
            result_data = {"status": "failed", "operation": "create", "message": str(error)}
            if cleanup_errors:
                result_data["cleanup_errors"] = cleanup_errors
            data.update(status="failed", result=result_data, cleanup={
                "outer_creation_attempted": outer_creation_attempted, "outer_removed": not cleanup_errors})
            write_session(data)
        finally:
            signal.signal(signal.SIGINT, previous_sigint)
        raise


def get_session(name):
    path = session_path(name)
    if not path.exists():
        raise RuntimeError(f"unknown fleet session: {name}")
    return json.loads(path.read_text())


def cmd_status(args):
    sessions = read_sessions()
    if args.session:
        sessions = [get_session(args.session)]
    # Aggregation reads coordinator-owned manifests only; it never enters a
    # sibling workspace or exposes another session's write surface.
    print(json.dumps({"sessions": sessions, "counts": {status: sum(s["status"] == status for s in sessions) for status in sorted({s["status"] for s in sessions})}}, indent=2))


def cmd_cancel(args):
    data = get_session(args.session)
    if data["status"] in {"cancelled", "destroyed"}:
        return
    returncode = inner_controller(data, "stop", args.session)
    status = "cancelled" if returncode == 0 else "failed"
    data.update(status=status, last_activity_at=now(), result={"status": status, "operation": "cancel", "exit_code": returncode})
    write_session(data)
    if returncode:
        raise RuntimeError(f"cancellation failed in {args.session}; sibling sessions were not changed")


def cmd_run(args):
    data = get_session(args.session)
    returncode = inner_controller(data, "module", args.session, args.operation, args.module)
    status = "succeeded" if returncode == 0 else "failed"
    data.update(status="ready" if returncode == 0 else "failed", last_activity_at=now(), result={"status": status, "operation": args.operation, "module": args.module, "exit_code": returncode})
    write_session(data)
    if returncode:
        raise RuntimeError(f"{args.operation} failed in {args.session}; sibling sessions were not changed")


def cmd_protect(args):
    data = get_session(args.session)
    data["cleanup_guard"][args.method] = True
    write_session(data)


def cmd_destroy(args):
    data = get_session(args.session)
    if data["status"] == "destroyed":
        return
    if not args.force and not any(data["cleanup_guard"].values()):
        raise RuntimeError("destructive cleanup refused: record commit, push, or patch_export first (or use --force)")
    inner = inner_controller(data, "destroy", args.session, "--allow-unexported")
    if inner:
        data.update(status="failed", result={"status": "failed", "operation": "destroy", "exit_code": inner})
        write_session(data)
        raise RuntimeError(f"inner cleanup failed for {args.session}; outer Sandbox retained")
    # The coordinator's explicit cleanup guard replaces sbx's interactive
    # confirmation, so non-interactive fleet cleanup may safely use --force.
    cloud = data.get("runtime", {}).get("mode") == "cloud"
    if cloud:
        proc = run(sbx("rm", "--force", args.session, cloud=True), check=False)
    else:
        proc = run(["sbx", "rm", "--force", args.session], check=False)
    data.update(status="destroyed" if proc.returncode == 0 else "failed", result={"status": "succeeded" if proc.returncode == 0 else "failed", "operation": "destroy", "exit_code": proc.returncode})
    write_session(data)
    if proc.returncode:
        raise RuntimeError(f"failed to remove Sandbox {args.session}")


def cmd_maintain(_args):
    config = policy()
    current = dt.datetime.now(dt.timezone.utc)
    outcomes = []
    for data in read_sessions():
        age = current - parse_time(data["last_activity_at"])
        if data["status"] in {"ready", "active"} and age >= dt.timedelta(minutes=config["idle_stop_minutes"]):
            returncode = inner_controller(data, "stop", data["session_id"])
            if returncode == 0:
                data["status"] = "stopped"
                write_session(data)
            outcomes.append({"session_id": data["session_id"], "action": "idle_stop", "exit_code": returncode})
        elif data["status"] == "stopped" and age >= dt.timedelta(days=config["stopped_retention_days"]):
            outcomes.append({"session_id": data["session_id"], "action": "retention_due", "exit_code": None})
    print(json.dumps({"outcomes": outcomes}, indent=2))


def parser():
    value = argparse.ArgumentParser()
    commands = value.add_subparsers(dest="command", required=True)
    create = commands.add_parser("create"); create.add_argument("--version", required=True); create.add_argument("--module", required=True); create.add_argument("--agent", choices=("codex", "claude", "copilot"), default="codex"); create.add_argument("--cloud", action="store_true", help="allocate in a Docker Cloud Sandbox (internal-only, no published port)"); create.add_argument("--import", dest="import_source", metavar="DIR", help="cloud only: ship this migrate-local.py staging tree and install it instead of a fixture"); create.add_argument("--requirements", metavar="FILE", action="append", help="cloud only, with --import: PyPI requirements file; repeat for several modules")
    status = commands.add_parser("status"); status.add_argument("session", nargs="?")
    cancel = commands.add_parser("cancel"); cancel.add_argument("session")
    execute = commands.add_parser("run"); execute.add_argument("session"); execute.add_argument("operation", choices=("install", "update", "test")); execute.add_argument("module")
    protect = commands.add_parser("protect"); protect.add_argument("session"); protect.add_argument("method", choices=("commit", "push", "patch_export"))
    destroy = commands.add_parser("destroy"); destroy.add_argument("session"); destroy.add_argument("--force", action="store_true")
    commands.add_parser("maintain")
    return value


def main():
    args = parser().parse_args()
    return globals()[f"cmd_{args.command}"](args)


if __name__ == "__main__":
    try:
        main()
    except (RuntimeError, subprocess.CalledProcessError, KeyboardInterrupt) as error:
        if isinstance(error, KeyboardInterrupt):
            print("sandbox-fleet: cancelled; sibling sessions were left running", file=sys.stderr)
            raise SystemExit(130)
        print(f"sandbox-fleet: {error}", file=sys.stderr)
        raise SystemExit(1)
