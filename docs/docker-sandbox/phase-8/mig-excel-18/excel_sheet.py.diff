+    def _read_workbook_rows(self, path, filetype):
+        """Return ``(header_list, [row_dict, ...])`` for an .xls or .xlsx file.
+
+        .xls is read with ``xlrd`` (still bundled with Odoo 18). ``xlrd`` >= 2.0
+        dropped .xlsx support, so .xlsx is read with ``openpyxl``. Both paths
+        produce the same ``{column_header: cell_value}`` shape the importer
+        already expects.
+        """
+        self.ensure_one()
+        if filetype == '.xls':
+            workbook = xlrd.open_workbook(path)
+            try:
+                sheet = workbook.sheet_by_name(self.document_sheet)
+            except Exception:
+                raise UserError(_("There is no sheet name '%s' in File. Please check properly." % self.document_sheet))
+            if not sheet.nrows:
+                return [], []
+            header = [c or '' for c in sheet.row_values(0)]
+            rows = []
+            for r in range(1, sheet.nrows):
+                rows.append({header[c]: sheet.cell_value(r, c) for c in range(sheet.ncols)})
+            return header, rows
+
+        try:
+            import openpyxl
+        except ImportError:
+            raise UserError(_("Reading .xlsx files requires the 'openpyxl' Python package on the Odoo server."))
+        try:
+            workbook = openpyxl.load_workbook(path, data_only=True, read_only=True)
+        except Exception as e:
+            raise UserError(_("Could not read the Excel file: %s") % e)
+        if self.document_sheet not in workbook.sheetnames:
+            raise UserError(_("There is no sheet name '%s' in File. Please check properly." % self.document_sheet))
+        sheet = workbook[self.document_sheet]
+        data_rows = list(sheet.iter_rows(values_only=True))
+        workbook.close()
+        if not data_rows:
+            return [], []
+        header = [c if c is not None else '' for c in data_rows[0]]
+        rows = []
+        for values in data_rows[1:]:
+            rows.append({header[c]: (values[c] if c < len(values) else None) for c in range(len(header))})
+        return header, rows
+
+    def _coerce_date_value(self, value):
+        """Normalise a spreadsheet cell to an ISO date string.
+
+        - ``datetime``/``date`` (openpyxl already parses these) -> ``.isoformat()``
+        - ``int``/``float`` (xlrd serial date) -> converted via ``xlrd``
+        - anything else (CSV strings, already-ISO text) -> returned unchanged
+        """
+        if isinstance(value, datetime.datetime):
+            return value.date().isoformat()
+        if isinstance(value, datetime.date):
+            return value.isoformat()
+        if isinstance(value, (int, float)) and not isinstance(value, bool):
+            return xlrd.xldate_as_datetime(value, 0).date().isoformat()
+        return value
+
 
